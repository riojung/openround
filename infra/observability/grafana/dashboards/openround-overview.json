  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(openround_active_sessions) OR vector(0)",
          "instant": true,
          "legendFormat": "Active sessions",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active sessions",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(openround_realtime_connections) OR vector(0)",
          "instant": true,
          "legendFormat": "Sockets",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Realtime connections",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "count(ALERTS{alertstate=\"firing\"}) OR vector(0)",
          "instant": true,
          "legendFormat": "Firing",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Firing alerts",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(openround_database_connections{state=\"waiting\"}) OR vector(0)",
          "instant": true,
          "legendFormat": "Waiting",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Database waiters",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (status_code) (rate(openround_http_request_duration_seconds_count[5m]))",
          "legendFormat": "HTTP {{status_code}}",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(openround_session_joins_total[5m]))",
          "legendFormat": "join {{outcome}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Request and join rates",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(openround_join_acknowledgement_duration_seconds_bucket{outcome=\"success\"}[5m])))",
          "legendFormat": "join p95",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(openround_answer_acknowledgement_duration_seconds_bucket{outcome=\"accepted\"}[5m])))",
          "legendFormat": "answer p95",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(openround_answer_acknowledgement_duration_seconds_bucket{outcome=\"accepted\"}[5m])))",
          "legendFormat": "answer p99",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Durable acknowledgement latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "options": {
        "legend": {
          "calcs": ["lastNotNull", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, event_type, role) (rate(openround_client_event_receipt_duration_seconds_bucket{outcome=\"acknowledged\"}[5m])))",
          "legendFormat": "{{role}} {{event_type}} p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Client event receipt round trip",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(openround_client_event_receipt_duration_seconds_count{outcome=\"timeout\"}[5m]))",
          "legendFormat": "receipt timeouts/s",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(openround_broadcast_duration_seconds_count{outcome=\"error\"}[5m]))",
          "legendFormat": "broadcast errors/s",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(openround_session_version_conflicts_total[5m]))",
          "legendFormat": "version conflicts/s",
          "range": true,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "sum(rate(openround_session_mutation_lease_wait_seconds_count{outcome=~\"timeout|error\"}[5m]))",
          "legendFormat": "lease failures/s",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Realtime reliability signals",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 9,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "openround_database_connections",
          "legendFormat": "database {{state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Database pool connections",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 10,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "openround_media_deletion_backlog OR vector(0)",
          "legendFormat": "media deletion backlog",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(openround_media_finalizations_total[10m]))",
          "legendFormat": "media {{outcome}}/s",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum by (outcome) (rate(openround_billing_webhooks_total[10m]))",
          "legendFormat": "billing {{outcome}}/s",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Media retention and billing",
      "type": "timeseries"
    }
  ],
