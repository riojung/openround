    {
      "datasource": { "type": "prometheus", "uid": "openround-prometheus" },
      "description": "Window-bound event-volume ratios for adjacent or closely related stages. These are directional product signals, not cohort conversion rates, and can exceed 100% around window boundaries.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "continuous-GrYlRd" }, "min": 0, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 11, "w": 8, "x": 16, "y": 29 },
      "id": 13,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true,
        "sizing": "auto",
        "valueMode": "color"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"creation_completed\"}[$__range])) OR vector(0)) / clamp_min(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"creation_started\"}[$__range])) OR vector(0), 1)",
          "instant": true,
          "legendFormat": "Create completion / starts",
          "range": false,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"round_published\"}[$__range])) OR vector(0)) / clamp_min(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"creation_started\"}[$__range])) OR vector(0), 1)",
          "instant": true,
          "legendFormat": "Published / create starts",
          "range": false,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"host_setup_completed\"}[$__range])) OR vector(0)) / clamp_min(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"round_published\"}[$__range])) OR vector(0), 1)",
          "instant": true,
          "legendFormat": "Host setup / published",
          "range": false,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"first_answer_submitted\"}[$__range])) OR vector(0)) / clamp_min(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"participant_joined\"}[$__range])) OR vector(0), 1)",
          "instant": true,
          "legendFormat": "First answer / joins",
          "range": false,
          "refId": "D"
        },
        {
          "editorMode": "code",
          "expr": "(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"response_saved_acknowledged\"}[$__range])) OR vector(0)) / clamp_min(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"first_answer_submitted\"}[$__range])) OR vector(0), 1)",
          "instant": true,
          "legendFormat": "Saved receipt / first answer",
          "range": false,
          "refId": "E"
        },
        {
          "editorMode": "code",
          "expr": "(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"insight_shown\"}[$__range])) OR vector(0)) / clamp_min(sum(increase(openround_product_events_total{beta_version=\"p0-2026\",name=\"question_locked\"}[$__range])) OR vector(0), 1)",
