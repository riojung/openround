{
  "schemaVersion": 1,
  "environment": "production",
  "deploymentMode": "single-vm",
  "publicWebUrl": "https://app.pollingpops.example",
  "publicApiUrl": "https://app.pollingpops.example",
  "publicMediaUrl": "https://media.pollingpops.example",
  "imageRepository": "ghcr.io/riojung/openround/openround",
  "imagePlatform": "linux/amd64",
  "billingMode": "stripe",
  "singleVm": {
    "host": "production-vm.pollingpops.example",
    "port": 22,
    "user": "openround",
    "deployPath": "/opt/pollingpops/production",
    "composeFiles": ["compose.single-vm.yaml", "compose.single-vm.observability.yaml"],
    "deploymentFiles": [
      "infra/single-vm/Caddyfile",
      "infra/single-vm/postgres-init.sh",
      "infra/observability/alerts.yml",
      "infra/observability/alertmanager.single-vm.yml",
      "infra/observability/otel-collector.single-vm.yml",
      "infra/observability/prometheus.single-vm.yml"
    ],
    "knownHostsFile": "config/deploy/ssh/production_known_hosts",
    "projectName": "openround-production"
  },
  "health": {
    "timeoutSeconds": 420,
    "intervalSeconds": 5,
    "requestTimeoutSeconds": 8
  },
  "requireSigning": true,
  "requireReadinessGate": true,
  "readinessTarget": "single-vm-beta",
  "cosignIdentityRegexp": "^https://github\\.com/riojung/(pollingpops|openround)/\\.github/workflows/release\\.yml@refs/tags/v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
  "cosignOidcIssuer": "https://token.actions.githubusercontent.com"
}
