{
  "schemaVersion": 1,
  "environment": "staging",
  "deploymentMode": "single-vm",
  "publicWebUrl": "https://staging.openround.example",
  "publicApiUrl": "https://staging.openround.example",
  "publicMediaUrl": "https://media-staging.openround.example",
  "imageRepository": "ghcr.io/riojung/openround/openround",
  "imagePlatform": "linux/amd64",
  "billingMode": "disabled",
  "singleVm": {
    "host": "staging-vm.openround.example",
    "port": 22,
    "user": "openround",
    "deployPath": "/opt/openround/staging",
    "composeFiles": ["compose.single-vm.yaml", "compose.single-vm.observability.yaml"],
    "deploymentFiles": [
      "infra/single-vm/Caddyfile",
      "infra/single-vm/postgres-init.sh",
      "infra/observability/alerts.yml",
      "infra/observability/alertmanager.single-vm.yml",
      "infra/observability/otel-collector.single-vm.yml",
      "infra/observability/prometheus.single-vm.yml"
    ],
    "knownHostsFile": "config/deploy/ssh/staging_known_hosts",
    "projectName": "openround-staging"
  },
  "health": {
    "timeoutSeconds": 300,
    "intervalSeconds": 5,
    "requestTimeoutSeconds": 8
  },
  "requireSigning": true,
  "requireReadinessGate": false,
  "cosignIdentityRegexp": "^https://github\\.com/riojung/openround/\\.github/workflows/staging-images\\.yml@refs/heads/main$",
  "cosignOidcIssuer": "https://token.actions.githubusercontent.com"
}
